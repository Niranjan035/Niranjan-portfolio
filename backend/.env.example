# ---------------------------------------------------------------------------
# Spring Boot environment variables. Do NOT commit a filled-in copy of this file.
# Use your OS environment, an IDE run configuration, or a git-ignored
# `application-local.yml` (see backend/src/main/resources/application.yml).
# ---------------------------------------------------------------------------

# --- Server ---
SERVER_PORT=8080
# Comma-separated list of allowed frontend origins. No trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
DB_USERNAME=root
DB_PASSWORD=

# --- SMTP (JavaMailSender) ---
# The provider is intentionally not assumed. Fill these in for whichever
# provider you use (Gmail app password, Outlook, Brevo, SendGrid, SES, ...).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# STARTTLS on 587, or set to an empty value and MAIL_PORT=465 for implicit SSL.
MAIL_STARTTLS_ENABLE=true
MAIL_SSL_ENABLE=false
# Some providers require a non-default local address.
MAIL_PROPERTIES_LOCALHOST=
# Optional. Address the mail is sent from, e.g. no-reply@yourdomain.com
# Leave blank to send from MAIL_USERNAME, which is what most providers require.
MAIL_FROM=
# Display name for the From header. Defaults to "Portfolio".
MAIL_FROM_NAME=Portfolio

# --- Contact form ---
# Where contact messages are delivered.
CONTACT_RECEIVER_EMAIL=niranjanhiremath11@gmail.com
CONTACT_STORE_IN_DATABASE=true
# Anti-abuse: max submissions allowed per IP inside the window.
CONTACT_RATE_LIMIT_MAX_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10
# Set to true while developing so messages are logged instead of sent.
CONTACT_MAIL_ENABLED=false

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
