# ---------------------------------------------------------------------------
# Copy this file to `.env` in the frontend folder and fill in real values.
# `.env` is git-ignored. Never commit real URLs or secrets.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot backend (used by the contact form).
VITE_API_BASE_URL=http://localhost:8080/api

# Canonical site origin, used for SEO <link rel="canonical"> and og:url.
# No trailing slash.
VITE_SITE_URL=http://localhost:5173

# NOTE: CORS is a BACKEND setting, not a frontend one. The allowed origins are
# configured with CORS_ALLOWED_ORIGINS in the backend environment
# (see backend/.env.example). Setting anything here has no effect.

# The contact address is NOT read from the environment. It lives in
# src/data/portfolio.ts as `identity.email`, which keeps a single source of truth
# for all site content.

# Public site title suffix, e.g. "Niranjan Hiremath | Software Developer"
VITE_DEFAULT_TITLE=Niranjan Hiremath | Software Developer & Full-Stack Developer
VITE_DEFAULT_DESCRIPTION=Portfolio of Niranjan Hiremath, a Software Developer and Full-Stack Developer.
